@{
    ViewData["Title"] = "Достъпът е отказан";
}

<div class="d-flex align-items-center justify-content-center" style="min-height: 60vh;">
    <div class="text-center px-3" style="max-width: 460px;">

        <div style="font-size: 4.5rem; line-height: 1; color: var(--algara-border);">
            <i class="bi bi-shield-lock"></i>
        </div>

        <h1 class="mt-3 mb-1" style="font-size: 1.6rem; font-weight: 700; color: var(--algara-text);">
            Нямате права за тази страница
        </h1>
        <p class="text-muted mb-4" style="font-size: .95rem;">
            Страницата, която се опитвате да достъпите, изисква по-високи привилегии.<br>
            Ако смятате, че това е грешка, свържете се с администратор.
        </p>

        <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center">
            <a asp-controller="Home" asp-action="Index" class="btn algara-btn-primary">
                <i class="bi bi-house me-1"></i>Към началото
            </a>
            <a asp-controller="Account" asp-action="Login" class="btn algara-btn-outline">
                <i class="bi bi-box-arrow-in-right me-1"></i>Вход с друг акаунт
            </a>
        </div>

    </div>
</div>
