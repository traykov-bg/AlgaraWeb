@model IReadOnlyList<Algara.Web.ViewModels.ProfileOrderRowViewModel>

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Поръчка</th>
                    <th>Статус</th>
                    <th class="text-center">Артикули</th>
                    <th class="text-end">Сума</th>
                    <th>Дата</th>
                    <th class="text-end">Детайли</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td class="fw-semibold">#@order.N</td>
                        <td><span class="badge @order.StatusCssClass">@order.StatusLabel</span></td>
                        <td class="text-center">@order.ItemCount</td>
                        <td class="text-end fw-semibold">@order.TotalAmount.ToString("N0") €</td>
                        <td class="text-muted small">
                            @order.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                            @if (order.UpdatedAt.HasValue)
                            {
                                <span class="d-block">обновена @order.UpdatedAt.Value.ToString("dd.MM.yyyy HH:mm")</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="OrderDetails" asp-route-n="@order.N" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-eye me-1"></i>Виж
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="text-center text-muted py-4">
        <i class="bi bi-receipt d-block mb-2" style="font-size:2rem;"></i>
        Няма поръчки в тази секция.
    </div>
}
