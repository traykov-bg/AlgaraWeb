<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Алгара Администрация</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root { --admin-sidebar: 230px; }

        body { overflow-x: hidden; }

        /* ── Sidebar ── */
        .admin-sidebar {
            width: var(--admin-sidebar);
            min-height: 100vh;
            background: #1a1d21;
            display: flex;
            flex-direction: column;
            flex-shrink: 0;
            position: sticky;
            top: 0;
            height: 100vh;
            overflow-y: auto;
        }
        .admin-sidebar .sidebar-brand {
            font-weight: 700;
            font-size: 1rem;
            color: #fff;
            text-decoration: none;
            padding: 1.25rem 1rem;
            display: flex;
            align-items: center;
            gap: .5rem;
            border-bottom: 1px solid rgba(255,255,255,.1);
        }
        .admin-sidebar .nav-link {
            color: rgba(255,255,255,.65);
            padding: .55rem 1rem;
            font-size: .88rem;
            border-radius: 6px;
            margin: 1px 8px;
            display: flex;
            align-items: center;
            gap: .6rem;
            transition: background .15s, color .15s;
        }
        .admin-sidebar .nav-link:hover { color: #fff; background: rgba(255,255,255,.08); }
        .admin-sidebar .nav-link.active { color: #fff; background: var(--algara-accent, #B85C38); }
        .admin-sidebar .nav-section {
            font-size: .7rem;
            text-transform: uppercase;
            letter-spacing: .08em;
            color: rgba(255,255,255,.35);
            padding: 1rem 1rem .3rem;
        }

        /* ── Content area ── */
        .admin-content {
            flex: 1;
            min-width: 0;
            background: #f4f6f9;
            min-height: 100vh;
        }
        .admin-topbar {
            background: #fff;
            border-bottom: 1px solid #dee2e6;
            padding: .75rem 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .admin-main { padding: 1.5rem; }
    </style>
</head>
<body>
<div class="d-flex">

    <!-- ── Sidebar ─────────────────────────────────────────── -->
    <nav class="admin-sidebar">
        <a class="sidebar-brand" asp-controller="Admin" asp-action="Index">
            <i class="bi bi-shield-check fs-5"></i> Алгара Админ
        </a>

        <div class="flex-grow-1 pt-2">
            <div class="nav-section">Управление</div>
            <ul class="nav flex-column">
                <li>
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                       asp-controller="Admin" asp-action="Index">
                        <i class="bi bi-speedometer2"></i> Табло
                    </a>
                </li>
                <li>
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString()?.StartsWith("Product") == true ? "active" : "")"
                       asp-controller="Admin" asp-action="Products">
                        <i class="bi bi-box-seam"></i> Продукти
                    </a>
                </li>
                <li>
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString()?.StartsWith("Category") == true ? "active" : "")"
                       asp-controller="Admin" asp-action="Categories">
                        <i class="bi bi-tags"></i> Категории
                    </a>
                </li>
                <li>
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString()?.StartsWith("HeroSlide") == true ? "active" : "")"
                       asp-controller="Admin" asp-action="HeroSlides">
                        <i class="bi bi-images"></i> Слайдер
                    </a>
                </li>
                <li>
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString()?.StartsWith("Promotion") == true ? "active" : "")"
                       asp-controller="Admin" asp-action="Promotions">
                        <i class="bi bi-tag"></i> Промоции
                    </a>
                </li>
                <li>
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString()?.StartsWith("Order") == true ? "active" : "")"
                       asp-controller="Admin" asp-action="Orders">
                        <i class="bi bi-bag-check"></i> Поръчки
                    </a>
                </li>
                <li>
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString()?.StartsWith("User") == true ? "active" : "")"
                       asp-controller="Admin" asp-action="Users">
                        <i class="bi bi-people"></i> Потребители
                    </a>
                </li>
            </ul>

            <div class="nav-section mt-2">Навигация</div>
            <ul class="nav flex-column">
                <li>
                    <a class="nav-link" asp-controller="Home" asp-action="Index" target="_blank">
                        <i class="bi bi-arrow-up-right-square"></i> Към сайта
                    </a>
                </li>
            </ul>
        </div>

        <div class="p-3 border-top" style="border-color: rgba(255,255,255,.1) !important;">
            <div class="text-white-50 small mb-2 ps-1">
                <i class="bi bi-person-circle me-1"></i>@User.Identity?.Name
            </div>
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="btn btn-sm btn-outline-light w-100">
                    <i class="bi bi-box-arrow-right me-1"></i>Изход
                </button>
            </form>
        </div>
    </nav>

    <!-- ── Main content ─────────────────────────────────────── -->
    <div class="admin-content d-flex flex-column">
        <div class="admin-topbar">
            <h6 class="mb-0 fw-semibold">@ViewData["Title"]</h6>
            <small class="text-muted">@DateTime.Today.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("bg-BG"))</small>
        </div>

        <div class="admin-main flex-grow-1">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-3" role="alert">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>@TempData["Success"]</span>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-3" role="alert">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span>@TempData["Error"]</span>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                </div>
            }

            <main role="main">
                @RenderBody()
            </main>
        </div>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
