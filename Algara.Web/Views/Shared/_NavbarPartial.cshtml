@inject Algara.Data.Repositories.ICategoryRepository _catRepo
@inject Algara.Identity.Data.IdentityDbContext _identityDb
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@{
    var navCategories = await _catRepo.GetAllWithSubCategoriesAsync();
    string? navDisplayName = null;

    if (User.Identity?.IsAuthenticated == true)
    {
        var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (!string.IsNullOrWhiteSpace(userId))
        {
            var navUser = await _identityDb.Users
                .Where(u => u.Id == userId && u.IsActive)
                .Select(u => new { u.FullName, u.FirstName, u.LastName, u.UserName, u.Email })
                .FirstOrDefaultAsync();

            if (navUser != null)
            {
                var fullNameFromParts = $"{navUser.FirstName} {navUser.LastName}".Trim();
                navDisplayName = !string.IsNullOrWhiteSpace(fullNameFromParts)
                    ? fullNameFromParts
                    : (!string.IsNullOrWhiteSpace(navUser.FullName) &&
                       !string.Equals(navUser.FullName, navUser.Email, StringComparison.OrdinalIgnoreCase) &&
                       !string.Equals(navUser.FullName, navUser.UserName, StringComparison.OrdinalIgnoreCase)
                        ? navUser.FullName
                        : navUser.UserName);
            }
        }
    }
}
<nav class="navbar navbar-expand-lg border-bottom algara-navbar">
    <div class="container-fluid px-3 px-lg-4">

        <button class="navbar-toggler border-0" type="button"
                data-bs-toggle="collapse" data-bs-target="#navbarMain"
                aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <a class="navbar-brand algara-navbar-brand d-lg-none mx-auto" asp-controller="Home" asp-action="Index">
            <img src="~/images/algara-logo.svg" alt="Алгара" height="36" class="d-inline-block align-text-top me-2" />
        </a>

        <div class="collapse navbar-collapse" id="navbarMain">
            <ul class="navbar-nav mb-2 mb-lg-0">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Index">Начало</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Product" asp-action="Index">Каталог</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-nowrap" asp-controller="Home" asp-action="About">За нас</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Contact">Контакти</a>
                </li>
                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item">
                        <a class="nav-link algara-nav-admin" asp-controller="Admin" asp-action="Index">
                            <i class="bi bi-shield-lock me-1"></i>Администрация
                        </a>
                    </li>
                }
            </ul>

            <a class="navbar-brand algara-navbar-brand d-none d-lg-flex mx-auto align-items-center" asp-controller="Home" asp-action="Index">
                <img src="~/images/algara-logo.svg" alt="Алгара" height="36" class="d-inline-block align-text-top me-2" />
            </a>

            <div class="d-flex flex-column flex-lg-row align-items-stretch align-items-lg-center gap-2 pb-2 pb-lg-0">
                <div class="algara-search-wrapper position-relative">
                    <form asp-controller="Product" asp-action="Index" method="get"
                          class="d-flex" id="algaraSearchForm">
                        <input id="algaraSearchInput"
                               class="form-control form-control-sm algara-search-input"
                               type="search" name="q"
                               placeholder="Търси продукт или категория…"
                               value="@ViewBag.SearchQuery"
                               autocomplete="off"
                               aria-label="Търсене" />
                        <button class="btn btn-sm algara-search-btn" type="submit" aria-label="Търси">
                            <i class="bi bi-search"></i>
                        </button>
                    </form>
                    <div id="algaraSearchDropdown" class="algara-search-dropdown" role="listbox"></div>
                </div>

                <div class="d-flex align-items-center gap-2 flex-shrink-0">
                    <a class="algara-cart-btn" asp-controller="Order" asp-action="Index" title="Количка">
                        <i class="bi bi-cart3"></i>
                    </a>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="algara-nav-user">
                            <button type="button" class="algara-nav-user__trigger" aria-haspopup="true" aria-expanded="false">
                                <i class="bi bi-person-circle me-1"></i>
                                <span>@(navDisplayName ?? User.Identity.Name)</span>
                                <i class="bi bi-chevron-down ms-1"></i>
                            </button>
                            <div class="algara-nav-user__menu">
                                <a asp-controller="Account" asp-action="Profile" class="algara-nav-user__item">
                                    <i class="bi bi-person-lines-fill me-2"></i>Профил
                                </a>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                    <button type="submit" class="algara-nav-user__item algara-nav-user__item--button">
                                        <i class="bi bi-box-arrow-right me-2"></i>Изход
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                    else
                    {
                        <button type="button" class="btn btn-sm algara-btn-ghost"
                                data-bs-toggle="modal" data-bs-target="#loginModal">Вход</button>
                        <a class="btn btn-sm algara-btn-primary-sm" asp-controller="Account" asp-action="Register">Регистрация</a>
                    }
                </div>
            </div>
        </div>
    </div>
</nav>

@if (User.Identity?.IsAuthenticated != true)
{
    @await Html.PartialAsync("_LoginModalPartial")
}

<nav class="algara-catbar">
    <div class="container-fluid px-0 px-lg-4 py-0 algara-catbar-scroll">
        <ul class="nav flex-nowrap flex-lg-wrap justify-content-lg-center">
            @foreach (var cat in navCategories)
            {
                var subCats = cat.SubCategories.Where(sc => sc.IsActive).OrderBy(sc => sc.Name).ToList();
                if (subCats.Any())
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="/kategorii/@cat.Slug">
                            @cat.Name
                        </a>
                        <ul class="dropdown-menu">
                            @foreach (var sub in subCats)
                            {
                                <li>
                                    <a class="dropdown-item" href="/kategorii/@cat.Slug?sub=@sub.Slug">
                                        @sub.Name
                                    </a>
                                </li>
                            }
                        </ul>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link" href="/kategorii/@cat.Slug">@cat.Name</a>
                    </li>
                }
            }
        </ul>
    </div>
</nav>
