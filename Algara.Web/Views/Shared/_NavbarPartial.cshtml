@inject Algara.Data.Repositories.ICategoryRepository _catRepo
@{
    var navCategories = await _catRepo.GetAllWithSubCategoriesAsync();
}
<nav class="navbar navbar-expand-lg border-bottom algara-navbar">
    <div class="container-fluid px-3 px-lg-4">

        <!-- Hamburger -->
        <button class="navbar-toggler border-0" type="button"
                data-bs-toggle="collapse" data-bs-target="#navbarMain"
                aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Brand for small screens: visible when collapsed, centered -->
        <a class="navbar-brand algara-navbar-brand d-lg-none mx-auto" asp-controller="Home" asp-action="Index">
            <img src="~/images/algara-logo.svg" alt="Алгара" height="36" class="d-inline-block align-text-top me-2" />
        </a>

        <div class="collapse navbar-collapse" id="navbarMain">

            <!-- ── Ляво: основна навигация ── -->
            <ul class="navbar-nav mb-2 mb-lg-0">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Index">Начало</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Product" asp-action="Index">Каталог</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-nowrap" asp-controller="Home" asp-action="About">За нас</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Contact">Контакти</a>
                </li>
                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item">
                        <a class="nav-link algara-nav-admin" asp-controller="Admin" asp-action="Index">
                            <i class="bi bi-shield-lock me-1"></i>Администрация
                        </a>
                    </li>
                }
            </ul>

            <!-- ── Център: Brand (само на lg+) -->
            <a class="navbar-brand algara-navbar-brand d-none d-lg-flex mx-auto align-items-center" asp-controller="Home" asp-action="Index">
                <img src="~/images/algara-logo.svg" alt="Алгара" height="36" class="d-inline-block align-text-top me-2" />
            </a>

            <!-- ── Дясно: търсачка + количка + потребител ── -->
            <div class="d-flex flex-column flex-lg-row align-items-stretch align-items-lg-center gap-2 pb-2 pb-lg-0">

                <!-- Търсачка с live dropdown -->
                <div class="algara-search-wrapper position-relative">
                    <form asp-controller="Product" asp-action="Index" method="get"
                          class="d-flex" id="algaraSearchForm">
                        <input id="algaraSearchInput"
                               class="form-control form-control-sm algara-search-input"
                               type="search" name="q"
                               placeholder="Търси продукт или категория…"
                               value="@ViewBag.SearchQuery"
                               autocomplete="off"
                               aria-label="Търсене" />
                        <button class="btn btn-sm algara-search-btn" type="submit" aria-label="Търси">
                            <i class="bi bi-search"></i>
                        </button>
                    </form>
                    <!-- Live-search dropdown — попълва се от JS -->
                    <div id="algaraSearchDropdown" class="algara-search-dropdown" role="listbox"></div>
                </div>

                <!-- Количка + потребител -->
                <div class="d-flex align-items-center gap-2 flex-shrink-0">

                    <a class="algara-cart-btn" asp-controller="Order" asp-action="Index" title="Количка">
                        <i class="bi bi-cart3"></i>
                    </a>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="algara-nav-user d-none d-lg-inline">
                            <i class="bi bi-person-circle me-1"></i>@User.Identity.Name
                        </span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline m-0">
                            <button type="submit" class="btn btn-sm algara-btn-outline-sm">Изход</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-sm algara-btn-ghost" asp-controller="Account" asp-action="Login">Вход</a>
                        <a class="btn btn-sm algara-btn-primary-sm" asp-controller="Account" asp-action="Register">Регистрация</a>
                    }
                </div>
            </div>

        </div>
    </div>
</nav>

<!-- ── Категорийна лента ── -->
<nav class="algara-catbar">
    <div class="container-fluid px-0 px-lg-4 py-0 algara-catbar-scroll">
        <ul class="nav flex-nowrap flex-lg-wrap justify-content-lg-center">
            @foreach (var cat in navCategories)
            {
                var subCats = cat.SubCategories.Where(sc => sc.IsActive).OrderBy(sc => sc.Name).ToList();
                if (subCats.Any())
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="/kategorii/@cat.Slug">
                            @cat.Name
                        </a>
                        <ul class="dropdown-menu">
                            @foreach (var sub in subCats)
                            {
                                <li>
                                    <a class="dropdown-item" href="/kategorii/@cat.Slug?sub=@sub.Slug">
                                        @sub.Name
                                    </a>
                                </li>
                            }
                        </ul>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link" href="/kategorii/@cat.Slug">@cat.Name</a>
                    </li>
                }
            }
        </ul>
    </div>
</nav>