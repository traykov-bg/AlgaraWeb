<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Алгара</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Algara.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        @await Html.PartialAsync("_NavbarPartial")
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-muted">
        <div class="footer-main py-5">
            <div class="container">
                <div class="row g-4">
                    <div class="col-md-4 col-sm-6">
                        <h5 class="footer-heading mb-3">За нас</h5>
                        <ul class="list-unstyled footer-links">
                            <li><a asp-controller="Home" asp-action="About" class="footer-link"><i class="bi bi-chevron-right me-1"></i>История</a></li>
                            <li><a asp-controller="Home" asp-action="Stores" class="footer-link"><i class="bi bi-chevron-right me-1"></i>Магазини</a></li>
                            <li><a asp-controller="Home" asp-action="Contact" class="footer-link"><i class="bi bi-chevron-right me-1"></i>Контакти</a></li>
                            <li><a asp-controller="Home" asp-action="Services" class="footer-link"><i class="bi bi-chevron-right me-1"></i>Услуги</a></li>
                        </ul>
                    </div>
                    <div class="col-md-4 col-sm-6">
                        <h5 class="footer-heading mb-3">За клиенти / Информация</h5>
                        <ul class="list-unstyled footer-links">
                            <li><a asp-controller="Home" asp-action="Delivery" class="footer-link"><i class="bi bi-chevron-right me-1"></i>Доставка</a></li>
                            <li><a asp-controller="Home" asp-action="HowToOrder" class="footer-link"><i class="bi bi-chevron-right me-1"></i>Как да поръчам</a></li>
                            <li><a asp-controller="Home" asp-action="Transport" class="footer-link"><i class="bi bi-chevron-right me-1"></i>Разнос и Монтаж</a></li>
                            <li><a asp-controller="Home" asp-action="Returns" class="footer-link"><i class="bi bi-chevron-right me-1"></i>Връщане на продукт</a></li>
                        </ul>
                    </div>
                    <div class="col-md-4 col-sm-12">
                        <h5 class="footer-heading mb-3">Обслужване на клиенти</h5>
                        <ul class="list-unstyled footer-contact">
                            <li class="mb-2">
                                <i class="bi bi-telephone me-2"></i>
                                <a href="tel:+359888000000" class="footer-link">+359 888 000 000</a>
                            </li>
                            <li class="mb-2">
                                <i class="bi bi-envelope me-2"></i>
                                <a href="mailto:info@algara.bg" class="footer-link">info@algara.bg</a>
                            </li>
                            <li class="mt-3">
                                <i class="bi bi-clock me-2"></i>
                                <strong>Работно време:</strong>
                                <ul class="list-unstyled ms-4 mt-1">
                                    <li>Пон – Съб: 10:00 – 17:00</li>
                                    <li>Нед: 11:00 – 15:00</li>
                                </ul>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <div class="footer-bottom border-top">
            <div class="container py-3 d-flex flex-wrap justify-content-between align-items-center">
                <span>&copy; @(DateTime.Today.Year) Алгара. Всички права запазени.</span>
                <span class="d-flex gap-3 mt-2 mt-md-0">
                    <a asp-controller="Home" asp-action="Privacy" class="footer-link small">Поверителност</a>
                    <a asp-controller="Home" asp-action="Terms" class="footer-link small">Общи условия</a>
                </span>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
