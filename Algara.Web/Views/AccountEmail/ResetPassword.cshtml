@model Algara.Web.ViewModels.ResetPasswordForm
@{ ViewData["Title"] = "Нова парола"; }
<div class="container py-4"><div class="row justify-content-center"><div class="col-md-8 col-lg-6">
<h1 class="h3">Нова парола</h1>
<p class="text-muted">Връзката е валидна един час. След смяната всички досегашни сесии ще бъдат прекратени.</p>
<partial name="_TokenHelp" />
<form asp-action="ResetPassword" method="post" data-account-email-token>
<input asp-for="Token" type="hidden" autocomplete="off" />
<div asp-validation-summary="All" class="text-danger mb-3"></div>
<label asp-for="Password" class="form-label">Нова парола</label>
<input asp-for="Password" class="form-control" autocomplete="new-password" value="" />
<label asp-for="ConfirmPassword" class="form-label mt-3">Потвърдете новата парола</label>
<input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" value="" />
<button type="submit" class="btn algara-btn-primary mt-3">Запази новата парола</button>
</form>
<a asp-action="ForgotPassword" class="d-inline-block mt-3">Поискай нова връзка</a>
</div></div></div>
@section Scripts { <script src="~/js/account-email-token.js" asp-append-version="true"></script><partial name="_ValidationScriptsPartial" /> }
