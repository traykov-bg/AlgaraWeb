@model Algara.Web.ViewModels.Admin.PaymentReport
@{Layout="_AdminLayout";ViewData["Title"]="Справка за плащания / Payment report";}
<h1 class="h3">Справка за плащания / Payment report</h1>
<form method="get" class="row g-2 mb-3">
<div class="col-md-4"><label asp-for="Search">Поръчка, име, телефон / Order, name, phone</label><input asp-for="Search" class="form-control"/></div>
<div class="col-md-4"><label asp-for="State">Състояние / State</label><select asp-for="State" class="form-select"><option value="">Всички / All</option><option value="Outstanding">Очакват плащане / Outstanding</option><option value="Unpaid">Неплатени / Unpaid</option><option value="Partial">Частично платени / Partial</option><option value="Paid">Изплатени / Paid</option><option value="Overdue">Просрочени / Overdue</option><option value="RefundDue">Отказани със средства / Cancelled with funds</option><option value="Legacy">Стари без платежна история / Legacy without ledger</option><option value="Overpaid">Надплатени / Overpaid</option></select></div>
<div class="col-md-4"><label asp-for="MethodN">С плащане по начин / Has payment method</label><select asp-for="MethodN" class="form-select"><option value="">Всички / All</option>@foreach(var m in Model.Methods){<option value="@m.N">@m.Name</option>}</select></div>
<div class="col-md-4"><label asp-for="PartnerN">№ на контрагент / Partner ID</label><input asp-for="PartnerN" class="form-control" min="1"/></div>
<div class="col-md-3"><label asp-for="From">Падеж от / Due from</label><input asp-for="From" type="date" class="form-control"/></div><div class="col-md-3"><label asp-for="To">Падеж до / Due to</label><input asp-for="To" type="date" class="form-control"/></div>
<div class="col-md-2 align-self-end"><button class="btn btn-success">Филтрирай / Filter</button></div></form>
<div class="alert alert-success">@Model.Count поръчки / orders · Обща стойност / Total: @Model.Total.ToString("N2") € · Нетно платено / Net paid: @Model.Paid.ToString("N2") € · За получаване / Outstanding: @Model.Outstanding.ToString("N2") €</div>
<p class="small text-muted">Сумите обхващат всички филтрирани поръчки. Филтърът по начин избира поръчки с такъв запис; платеното включва всички начини и корекции. Отказаните не участват в „За получаване“. / Totals cover all filtered orders; method selects orders with matching entries. Net paid includes all methods and reversals. Cancelled orders are excluded from outstanding.</p>
<div class="table-responsive"><table class="table table-striped"><thead><tr><th>Поръчка / Order</th><th>Клиент / Customer</th><th>Статус / Status</th><th>Общо / Total</th><th>Платено / Paid</th><th>Остатък / Balance</th><th>Падеж / Due</th></tr></thead><tbody>
@foreach(var r in Model.Rows){<tr><td><a asp-action="Order" asp-route-n="@r.N">#@r.N</a></td><td>@r.ContactName<br/>@r.ContactPhone</td><td>@r.Status @if(!r.Tracked){<span class="badge bg-secondary">Без платежна история / Untracked</span>}</td><td>@r.Total.ToString("N2") €</td><td>@r.Paid.ToString("N2") €</td><td>@((r.Status==Algara.Data.Models.OrderStatus.Cancelled?-r.Paid:r.Total-r.Paid).ToString("N2")) €</td><td>@(r.Due?.ToString("dd.MM.yyyy")??"—")</td></tr>}
</tbody></table></div>
<p>Страница / Page @Model.Page / @Model.Pages</p>
@foreach(var pageNumber in new[]{Model.Page-1,Model.Page+1}.Where(p=>p>=1&&p<=Model.Pages)){<a class="btn btn-outline-secondary" asp-route-page="@pageNumber" asp-route-search="@Model.Search" asp-route-state="@Model.State" asp-route-partnerN="@Model.PartnerN" asp-route-methodN="@Model.MethodN" asp-route-from="@(Model.From?.ToString("yyyy-MM-dd"))" asp-route-to="@(Model.To?.ToString("yyyy-MM-dd"))">@(pageNumber<Model.Page?"←":"→")</a>}
