@model Algara.Web.ViewModels.Admin.AdminPromotionFormViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" style="display:none;"></div>
<div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

@Html.HiddenFor(m => m.N)

<div class="row g-3">

    @* Наименование *@
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-body">
                <label asp-for="Name" class="form-label fw-semibold"></label>
                <input asp-for="Name" class="form-control" placeholder="напр. Лятна разпродажба" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
        </div>
    </div>

    @* Отстъпка и период *@
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-body py-3">
                <div class="d-flex flex-wrap align-items-end gap-4">

                    @* Отстъпка *@
                    <div>
                        <label asp-for="DiscountPercent" class="form-label text-muted small mb-1"></label>
                        <div class="input-group" style="width:130px;">
                            <input asp-for="DiscountPercent" type="number" min="0.001" max="99.999" step="0.001"
                                   class="form-control form-control-lg fw-bold text-center border-0 bg-light"
                                   style="font-size:1.4rem;" placeholder="0" />
                            <span class="input-group-text bg-light border-0 fw-bold text-muted">%</span>
                        </div>
                        <span asp-validation-for="DiscountPercent" class="text-danger small"></span>
                    </div>

                    @* Разделител *@
                    <div class="vr d-none d-md-block my-1" style="height:52px;"></div>

                    @* Период *@
                    <div class="d-flex align-items-end gap-2 flex-wrap">
                        <div>
                            <label asp-for="StartDate" class="form-label text-muted small mb-1">
                                <i class="bi bi-calendar-event me-1"></i>От
                            </label>
                            <input id="startDate" asp-for="StartDate" type="date"
                                   class="form-control border-0 bg-light"
                                   value="@Model.StartDate.ToString("yyyy-MM-dd")"
                                   style="width:150px;" />
                            <span asp-validation-for="StartDate" class="text-danger small"></span>
                        </div>
                        <span class="text-muted pb-2">→</span>
                        <div>
                            <label asp-for="EndDate" class="form-label text-muted small mb-1">
                                <i class="bi bi-calendar-check me-1"></i>До
                            </label>
                            <input id="endDate" asp-for="EndDate" type="date"
                                   class="form-control border-0 bg-light"
                                   value="@Model.EndDate.ToString("yyyy-MM-dd")"
                                   style="width:150px;" />
                            <span asp-validation-for="EndDate" class="text-danger small"></span>
                        </div>
                    </div>

                    @* Разделител *@
                    <div class="vr d-none d-md-block my-1" style="height:52px;"></div>

                    @* Активна *@
                    <div class="d-flex flex-column align-items-center pb-1">
                        <label class="form-label text-muted small mb-1">Активна</label>
                        <div class="form-check form-switch m-0">
                            <input asp-for="IsActive" type="checkbox" class="form-check-input" role="switch"
                                   style="width:2.5em; height:1.4em; cursor:pointer;" />
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <script>
    (function () {
        var start = document.getElementById('startDate');
        var end   = document.getElementById('endDate');
        if (!start || !end) return;

        // След избор на начална дата → отвори крайната (ако е празна или е преди началната)
        start.addEventListener('change', function () {
            if (end.min !== this.value) end.min = this.value;
            if (!end.value || end.value < this.value) {
                end.value = this.value;
            }
            end.showPicker && end.showPicker();
        });

        // Ако крайната се фокусира без начална → отвори началната
        end.addEventListener('focus', function () {
            if (!start.value) {
                start.focus();
                start.showPicker && start.showPicker();
            }
        });
    }());
    </script>

    @* Избор на продукти *@
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header fw-semibold">
                <i class="bi bi-box-seam me-1"></i>
                Продукти в промоцията
                <span id="selectedCount" class="badge bg-primary ms-2">@Model.SelectedProductNs.Count избрани</span>
            </div>
            <div class="card-body p-2">
                <div class="mb-2 px-2 d-flex gap-2">
                    <i class="bi bi-search text-muted ms-1"></i>
                    <input type="text" id="productSearch" class="form-control form-control-sm"
                           placeholder="Търси продукт..."
                           style="width:25%;"
                           onkeydown="if(event.key==='Enter'){event.preventDefault();}" />
                    <button type="button" class="btn btn-outline-secondary btn-sm"
                            onclick="document.getElementById('productSearch').value='';algaraPromoFilter();"
                            title="Изчисти">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
                <script>
                    function algaraPromoFilter() {
                        var q = document.getElementById('productSearch').value.toLowerCase().trim();
                        document.querySelectorAll('[data-product-name]').forEach(function (row) {
                            row.classList.toggle('d-none', !(row.getAttribute('data-product-name') || '').includes(q));
                        });
                    }
                </script>
                <div style="max-height: 340px; overflow-y: auto; border-top: 1px solid #dee2e6;">
                    @foreach (var product in Model.AllProducts)
                    {
                        var isChecked = Model.SelectedProductNs.Contains(product.N);
                        <label class="product-row d-flex align-items-center gap-2 px-3 py-2 border-bottom"
                               data-product-name="@product.Name.ToLower()"
                               style="cursor:pointer; @(isChecked ? "background:#fff8e1;" : "")">
                            <input type="checkbox" name="SelectedProductNs" value="@product.N"
                                   class="form-check-input product-checkbox flex-shrink-0"
                                   @(isChecked ? "checked" : "") />
                            @if (!string.IsNullOrEmpty(product.ImageUrl))
                            {
                                <img src="@product.ImageUrl" alt="" width="36" height="36"
                                     style="object-fit:cover; border-radius:4px; flex-shrink:0;" />
                            }
                            else
                            {
                                <div style="width:36px;height:36px;background:#eee;border-radius:4px;flex-shrink:0;"></div>
                            }
                            <div class="flex-grow-1 overflow-hidden">
                                <div class="promo-product-name fw-semibold text-truncate small">@product.Name</div>
                                <div class="text-muted" style="font-size:.75rem;">@product.Price.ToString("N0") €</div>
                            </div>
                        </label>
                    }
                </div>
            </div>
        </div>
    </div>

</div>

<script>
    function algaraPromoUpdateCount() {
        var n = document.querySelectorAll('.product-checkbox:checked').length;
        document.getElementById('selectedCount').textContent = n + ' избрани';
    }

    document.addEventListener('DOMContentLoaded', function () {
        // Автоматично филтриране при писане
        document.getElementById('productSearch').addEventListener('input', algaraPromoFilter);

        // Checkbox: обнови брояча и фона
        document.querySelectorAll('.product-checkbox').forEach(function (cb) {
            cb.addEventListener('change', function () {
                this.closest('.product-row').style.background = this.checked ? '#fff8e1' : '';
                algaraPromoUpdateCount();
            });
        });

        algaraPromoUpdateCount();
    });
</script>
