@model Algara.Web.ViewModels.Admin.AdminPromotionFormViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" style="display:none;"></div>
<div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

@Html.HiddenFor(m => m.N)

<div class="row g-3">

    @* Наименование *@
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-body">
                <label asp-for="Name" class="form-label fw-semibold"></label>
                <input asp-for="Name" class="form-control" placeholder="напр. Лятна разпродажба" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
        </div>
    </div>

    @* Отстъпка и период *@
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label asp-for="DiscountPercent" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <input asp-for="DiscountPercent" type="number" min="1" max="99"
                                   class="form-control" placeholder="10" />
                            <span class="input-group-text">%</span>
                        </div>
                        <span asp-validation-for="DiscountPercent" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="StartDate" class="form-label fw-semibold"></label>
                        <input asp-for="StartDate" type="date" class="form-control"
                               value="@Model.StartDate.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="StartDate" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="EndDate" class="form-label fw-semibold"></label>
                        <input asp-for="EndDate" type="date" class="form-control"
                               value="@Model.EndDate.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="EndDate" class="text-danger small"></span>
                    </div>
                    <div class="col-md-1 d-flex align-items-end">
                        <div class="form-check pb-2">
                            <input asp-for="IsActive" type="checkbox" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label fw-semibold">Активна</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Избор на продукти *@
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header fw-semibold">
                <i class="bi bi-box-seam me-1"></i>
                Продукти в промоцията
                <span id="selectedCount" class="badge bg-primary ms-2">@Model.SelectedProductNs.Count избрани</span>
            </div>
            <div class="card-body p-2">
                <div class="mb-2 px-2 d-flex gap-2">
                    <input type="text" id="productSearch" class="form-control form-control-sm"
                           placeholder="Търси продукт..."
                           style="width:25%;"
                           onkeydown="if(event.key==='Enter'){event.preventDefault();algaraPromoFilter();}" />
                    <button type="button" class="btn btn-outline-secondary btn-sm"
                            onclick="algaraPromoFilter()">
                        <i class="bi bi-search"></i> Филтрирай
                    </button>
                    <button type="button" class="btn btn-outline-danger btn-sm"
                            onclick="document.getElementById('productSearch').value='';algaraPromoFilter();">
                        <i class="bi bi-x"></i>
                    </button>
                </div>
                <script>
                function algaraPromoFilter() {
                    var q = document.getElementById('productSearch').value.toLowerCase().trim();
                    document.querySelectorAll('[data-product-name]').forEach(function (row) {
                        row.style.display = row.getAttribute('data-product-name').includes(q) ? '' : 'none';
                    });
                }
                </script>
                <div style="max-height: 340px; overflow-y: auto; border-top: 1px solid #dee2e6;">
                    @foreach (var product in Model.AllProducts)
                    {
                        var isChecked = Model.SelectedProductNs.Contains(product.N);
                        <label class="product-row d-flex align-items-center gap-2 px-3 py-2 border-bottom"
                               data-product-name="@product.Name.ToLower()"
                               style="cursor:pointer; @(isChecked ? "background:#fff8e1;" : "")">
                            <input type="checkbox" name="SelectedProductNs" value="@product.N"
                                   class="form-check-input product-checkbox flex-shrink-0"
                                   @(isChecked ? "checked" : "") />
                            @if (!string.IsNullOrEmpty(product.ImageUrl))
                            {
                                <img src="@product.ImageUrl" alt="" width="36" height="36"
                                     style="object-fit:cover; border-radius:4px; flex-shrink:0;" />
                            }
                            else
                            {
                                <div style="width:36px;height:36px;background:#eee;border-radius:4px;flex-shrink:0;"></div>
                            }
                            <div class="flex-grow-1 overflow-hidden">
                                <div class="promo-product-name fw-semibold text-truncate small">@product.Name</div>
                                <div class="text-muted" style="font-size:.75rem;">@product.Price.ToString("N0") €</div>
                            </div>
                        </label>
                    }
                </div>
            </div>
        </div>
    </div>

</div>

<script>
// Обнови брояча и фона при промяна на checkbox
function algaraPromoUpdateCount() {
    var n = document.querySelectorAll('.product-checkbox:checked').length;
    document.getElementById('selectedCount').textContent = n + ' избрани';
}
document.querySelectorAll('.product-checkbox').forEach(function (cb) {
    cb.addEventListener('change', function () {
        this.closest('.product-row').style.background = this.checked ? '#fff8e1' : '';
        algaraPromoUpdateCount();
    });
});
algaraPromoUpdateCount();
</script>
