@model Algara.Web.ViewModels.Admin.AdminUserListViewModel
@using Algara.Web.ViewModels.Admin
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Потребители";
    var allRoles = ViewBag.AllRoles as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? [];
}

<form asp-action="Users" method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-7">
        <label for="user-search" class="form-label">Търси потребител</label>
        <input id="user-search" name="search" value="@Model.Search" class="form-control" type="search" maxlength="200" placeholder="Номер, име, потребителско име, имейл или телефон" />
    </div>
    <div class="col-md-3">
        <label for="user-active" class="form-label">Статус</label>
        <select id="user-active" name="active" class="form-select">
            <option value="" selected="@(Model.Active == null)">Всички</option>
            <option value="true" selected="@(Model.Active == true)">Активни</option>
            <option value="false" selected="@(Model.Active == false)">Неактивни</option>
        </select>
    </div>
    <div class="col-md-2"><button type="submit" class="btn btn-primary">Търси</button></div>
</form>
<p class="text-muted small">@Model.Total потребители · страница @Model.Page от @Model.TotalPages</p>
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover table-sm mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Потребител</th>
                    <th>Имейл / телефон</th>
                    <th class="text-center">Статус</th>
                    <th>Роли</th>
                    <th staff-permission="Users.View,Users.ViewDossier">Клиентско досие</th>
                    <th class="text-end" staff-permission="Access.AssignRoles">Управление на роли</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td class="text-muted small">@row.User.N</td>
                        <td class="fw-semibold small">@(string.IsNullOrWhiteSpace(row.User.DisplayName) ? row.User.UserName : row.User.DisplayName)<div class="fw-normal text-muted">@row.User.UserName</div></td>
                        <td class="small text-muted">@row.User.Email<div>@row.User.PhoneNumber</div></td>
                        <td class="text-center">
                            @if (row.User.IsActive)
                            {
                                <span class="badge bg-success">Активен</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Неактивен</span>
                            }
                        </td>
                        <td>
                            @foreach (var role in row.Roles)
                            {
                                <span class="badge bg-primary me-1">@AdminAccessFormViewModel.RoleLabel(role)</span>
                            }
                            @if (!row.Roles.Any())
                            {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                        <td staff-permission="Users.View,Users.ViewDossier"><a asp-controller="AdminCustomers" asp-action="Dossier" asp-route-n="@row.User.N" class="btn btn-sm btn-outline-primary">Досие</a></td>
                        <td class="text-end" staff-permission="Access.AssignRoles">
                            @if (row.User.IsActive)
                            {
                            <div class="d-flex gap-1 justify-content-end flex-wrap">
                                <!-- Премахване на роля -->
                                @foreach (var role in row.Roles.Where(r => r == "User" || Algara.Identity.Authorization.StaffRoles.IsStaff(r)))
                                {
                                    <form asp-action="RemoveRole" method="post" class="d-inline" staff-permission="Users.View,Access.AssignRoles">
                                        <input type="hidden" name="Username" value="@row.User.UserName" /><input type="hidden" name="ExpectedSecurityStamp" value="@row.User.SecurityStamp" />
                                        <input type="hidden" name="RoleName" value="@role" />
                                        <button type="submit" class="btn btn-xs btn-outline-danger"
                                                style="padding:.15rem .45rem;font-size:.75rem;"
                                                title="Премахни роля @AdminAccessFormViewModel.RoleLabel(role)">
                                            <i class="bi bi-x"></i> @AdminAccessFormViewModel.RoleLabel(role)
                                        </button>
                                    </form>
                                }
                                <!-- Добавяне на роля -->
                                <form asp-action="AssignRole" method="post" class="d-inline d-flex gap-1" staff-permission="Users.View,Access.AssignRoles">
                                    <input type="hidden" name="Username" value="@row.User.UserName" /><input type="hidden" name="ExpectedSecurityStamp" value="@row.User.SecurityStamp" />
                                    <select name="RoleName" class="form-select form-select-sm" required aria-label="Роля за добавяне"
                                            style="font-size:.78rem;padding:.15rem .4rem;min-width:90px;">
                                        <option value="">Изберете роля…</option>
                                        @foreach (var r in allRoles.Where(r => !row.Roles.Contains(r.Value)))
                                        {
                                            <option value="@r.Value">@r.Text</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-xs btn-outline-success"
                                            style="padding:.15rem .45rem;font-size:.75rem;" title="Добави роля">
                                        <i class="bi bi-plus"></i>
                                    </button>
                                </form>
                            </div>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Rows.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">Няма намерени потребители.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
@if (Model.TotalPages > 1)
{
    <nav class="d-flex gap-2 mt-3" aria-label="Страници с потребители">
        @if (Model.Page > 1) { <a asp-action="Users" asp-route-search="@Model.Search" asp-route-active="@Model.Active" asp-route-page="@(Model.Page - 1)" class="btn btn-outline-secondary">Предишни</a> }
        <span class="align-self-center">Страница @Model.Page от @Model.TotalPages</span>
        @if (Model.Page < Model.TotalPages) { <a asp-action="Users" asp-route-search="@Model.Search" asp-route-active="@Model.Active" asp-route-page="@(Model.Page + 1)" class="btn btn-outline-secondary">Следващи</a> }
    </nav>
}
