@inject Algara.Identity.Authorization.StaffAccessService StaffAccess
@{ var canChangeActive = await StaffAccess.HasPermissionAsync(User, "Partners.Deactivate"); }
@model Algara.Web.ViewModels.Admin.PartnerForm
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = Model.N.HasValue ? "Редакция на контрагент" : "Нов контрагент";
}
<div class="card border-0 shadow-sm" style="max-width:65rem"><div class="card-body p-4">
    <form asp-action="@(Model.N.HasValue ? "PartnerEdit" : "PartnerCreate")" asp-route-n="@Model.N" method="post">
        <input asp-for="N" type="hidden" /><input asp-for="RowVersion" type="hidden" />
        <div asp-validation-summary="All" class="alert alert-danger"></div>
        <div class="row g-3">
            <div class="col-12"><label asp-for="SiteName" class="form-label">Име на обекта *</label><input asp-for="SiteName" class="form-control" maxlength="400" required aria-describedby="partner-name-help" /><div id="partner-name-help" class="form-text">Уникално име за всеки контрагент — човек, фирмен обект или клиент на дребно.</div></div>
            <div class="col-md-4"><label asp-for="Code" class="form-label">Код</label><input asp-for="Code" class="form-control" inputmode="numeric" maxlength="32" /><div class="form-text">При празно поле се определя автоматично; при редакция се запазва текущият.</div></div>
            <div class="col-md-8">
                @{ var canMove = !Model.N.HasValue || await StaffAccess.HasPermissionAsync(User, "Partners.Move"); }
                @if (!canMove) { <input type="hidden" asp-for="GroupN" /> }
                <label asp-for="GroupN" class="form-label">Група</label><select asp-for="GroupN" asp-items="Model.Groups" class="form-select" disabled="@(!canMove)"></select>
            </div>
            <div class="col-12"><label asp-for="CompanyN" class="form-label">Фирма</label><select asp-for="CompanyN" asp-items="Model.Companies" class="form-select" aria-describedby="partner-company-help"><option value="">Без фирма — физическо лице</option></select><div id="partner-company-help" class="form-text">Може да добавите, смените или премахнете фирмата по всяко време. Фирмените реквизити се поддържат във „Фирми“.</div></div>
            <div class="col-md-6"><label asp-for="Phone" class="form-label">Телефон</label><input asp-for="Phone" class="form-control" type="tel" /><div class="form-text">Незадължителен. 0888… или +359888…; без номер оставете празно или въведете 0.</div></div>
            <div class="col-md-6"><label asp-for="Email" class="form-label">Имейл</label><input asp-for="Email" class="form-control" type="email" /></div>
            <div class="col-12"><label asp-for="ContactPerson" class="form-label">Лице за контакт</label><input asp-for="ContactPerson" class="form-control" /></div>
            <div class="col-12"><fieldset class="border rounded p-3"><legend class="float-none w-auto px-2 fs-6">Основен адрес</legend>@Html.EditorFor(m => m.Address)</fieldset></div>
            <div class="col-12"><details class="border rounded p-3"><summary class="fw-semibold mb-2">Отделен адрес за доставка (незадължителен)</summary>@Html.EditorFor(m => m.DeliveryAddress)</details></div>
            <div class="col-12"><label asp-for="Notes" class="form-label">Служебни бележки</label><textarea asp-for="Notes" class="form-control" rows="3"></textarea></div>
            <div class="col-12 form-check ms-2">@if (!canChangeActive) { <input type="hidden" name="IsActive" value="@Model.IsActive.ToString().ToLowerInvariant()" /> }
<input disabled="@(!canChangeActive)" asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Активен контрагент</label></div>
        </div>
        <div class="d-flex flex-wrap gap-2 mt-4"><button type="submit" class="btn btn-primary">Запиши</button><a asp-action="Partners" asp-route-groupN="@Model.GroupN" class="btn btn-outline-secondary" staff-permission="Partners.View">Откажи</a>
        @if (Model.N.HasValue) { <a asp-action="PartnerEdit" asp-route-n="@Model.N" class="btn btn-outline-secondary" staff-permission="Partners.View,Partners.Edit">Презареди записаното</a> }</div>
    </form>
</div></div>
<partial name="_PartnerCatalogHistory" model="Model" />
@if (Model.CanViewLinkedAccounts)
{
    <section class="card border-0 shadow-sm mt-3" style="max-width:65rem" aria-labelledby="linked-accounts-title">
        <div class="card-header bg-white"><h2 id="linked-accounts-title" class="h6 mb-0">Свързани клиентски акаунти</h2></div>
        <div class="card-body">
            <p class="small text-muted">Свързването се извършва от досието на конкретния акаунт след проверка на принадлежността и искането на клиента.</p>
            <div class="table-responsive"><table class="table table-sm align-middle">
                <thead><tr><th>Акаунт</th><th>Имейл</th><th>Статус</th><th>Досие</th></tr></thead>
                <tbody>
                    @foreach (var account in Model.LinkedAccounts)
                    {
                        <tr>
                            <td><strong>#@account.N · @(string.IsNullOrWhiteSpace(account.DisplayName) ? account.UserName : account.DisplayName)</strong><div class="small text-muted">@account.UserName</div></td>
                            <td>@account.Email</td>
                            <td><span class="badge @(account.IsActive ? "bg-success" : "bg-secondary")">@(account.IsActive ? "Активен" : "Неактивен")</span></td>
                            <td><a asp-controller="AdminCustomers" asp-action="Dossier" asp-route-n="@account.N" class="btn btn-sm btn-outline-primary">Отвори досието</a></td>
                        </tr>
                    }
                    @if (Model.LinkedAccounts.Count == 0) { <tr><td colspan="4" class="text-muted py-3">Няма свързани акаунти на тази страница.</td></tr> }
                </tbody>
            </table></div>
            @if (Model.LinkedAccountsPage > 1 || Model.HasMoreLinkedAccounts)
            {
                <nav aria-label="Страници със свързани акаунти" class="d-flex gap-2">
                    @if (Model.LinkedAccountsPage > 1) { <a asp-action="PartnerEdit" asp-route-n="@Model.N" asp-route-linkedPage="@(Model.LinkedAccountsPage - 1)" asp-fragment="linked-accounts-title" class="btn btn-sm btn-outline-secondary">Предишни</a> }
                    <span class="align-self-center small">Страница @Model.LinkedAccountsPage</span>
                    @if (Model.HasMoreLinkedAccounts) { <a asp-action="PartnerEdit" asp-route-n="@Model.N" asp-route-linkedPage="@(Model.LinkedAccountsPage + 1)" asp-fragment="linked-accounts-title" class="btn btn-sm btn-outline-secondary">Следващи</a> }
                </nav>
            }
        </div>
    </section>
}
