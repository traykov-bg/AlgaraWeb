@model Algara.Web.ViewModels.Admin.AdminPromotionFormViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Нова промоция";
}

<div class="mb-3">
    <a asp-action="Promotions" class="btn btn-outline-secondary btn-sm" staff-permission="Promotions.View">
        <i class="bi bi-arrow-left me-1"></i>Към промоциите
    </a>
</div>

<form asp-action="PromotionCreate" method="post" staff-permission="Promotions.View,Promotions.Create">
    @await Html.PartialAsync("_PromotionFormFields", Model)
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg me-1"></i>Създай промоция
        </button>
    </div>
</form>
