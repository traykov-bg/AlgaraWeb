@model Algara.Web.ViewModels.Admin.AdminCategoryFormViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Редактирай категория";
}

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header fw-semibold py-3">
                <i class="bi bi-pencil-square me-1"></i>Основни данни
            </div>
            <div class="card-body p-4">
                @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
                {
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>
                }
                <form asp-action="CategoryEdit" asp-route-n="@Model.N" method="post">
                    <input type="hidden" asp-for="N" />
                    @await Html.PartialAsync("_CategoryFormFields", Model)
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-floppy me-1"></i>Запиши
                        </button>
                        <a asp-action="Categories" class="btn btn-outline-secondary">Откажи</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header fw-semibold py-3">
                <i class="bi bi-diagram-3 me-1"></i>Под-категории
            </div>
            <div class="card-body p-4">
                @if (Model.SubCategories.Any())
                {
                    <ul class="list-group mb-3">
                        @foreach (var sub in Model.SubCategories)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center py-2 px-3">
                                <div>
                                    <span class="fw-semibold">@sub.Name</span>
                                    <br />
                                    <code class="text-muted small">/kategorii/@Model.Slug/@sub.Slug</code>
                                </div>
                                <form asp-action="SubCategoryDelete" asp-route-sn="@sub.N" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-danger btn-sm"
                                            style="padding:.2rem .5rem;font-size:.78rem;"
                                            onclick="return confirm('Изтриване на под-категория?')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted small mb-3">Няма добавени под-категории.</p>
                }

                <hr class="my-3" />
                <p class="fw-semibold small mb-2">Добави нова под-категория</p>
                <form asp-action="SubCategoryAdd" asp-route-n="@Model.N" method="post" class="d-flex gap-2">
                    <input type="text" name="name" class="form-control form-control-sm"
                           placeholder="Напр. Дивани, Кресла..." required maxlength="200" />
                    <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap">
                        <i class="bi bi-plus-lg me-1"></i>Добави
                    </button>
                </form>
                <div class="form-text mt-1">Slug-ът се генерира автоматично от наименованието.</div>
            </div>
        </div>
    </div>
</div>
