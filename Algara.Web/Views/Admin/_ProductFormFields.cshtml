@inject Algara.Identity.Authorization.StaffAccessService StaffAccess
@{ var canChangeActive = await StaffAccess.HasPermissionAsync(User, "Products.Deactivate"); }
@model Algara.Web.ViewModels.Admin.AdminProductFormViewModel

<div class="mb-4">
    <label asp-for="Sku" class="form-label fw-semibold"></label>
    <input asp-for="Sku" class="form-control" maxlength="64" placeholder="Автоматично при запис" />
    <div class="form-text">Уникален код с латински букви, цифри, тире или долна черта. При нов продукт празното поле генерира код; при редакция запазва сегашния.</div>
    <span asp-validation-for="Sku" class="text-danger small"></span>
</div>

<h2 class="h6 fw-semibold">Български — основно съдържание</h2>
<div class="mb-3">
    <label asp-for="Name" class="form-label fw-semibold"></label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger small"></span>
</div>

<div class="mb-3">
    <label asp-for="Description" class="form-label fw-semibold"></label>
    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
    <span asp-validation-for="Description" class="text-danger small"></span>
</div>

<div class="mb-3">
    <label asp-for="Materials" class="form-label fw-semibold"></label>
    <textarea asp-for="Materials" class="form-control" rows="2"></textarea>
    <span asp-validation-for="Materials" class="text-danger small"></span>
</div>

<details class="border rounded p-3 mb-4" open="@(Model.EnglishName != null || Model.EnglishDescription != null || Model.EnglishMaterials != null)">
    <summary class="fw-semibold">English — превод</summary>
    <p class="text-muted small mt-2">Всяко празно поле използва съответния български текст.</p>
    <div class="mb-3">
        <label asp-for="EnglishName" class="form-label"></label>
        <input asp-for="EnglishName" class="form-control" lang="en" />
        <span asp-validation-for="EnglishName" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="EnglishDescription" class="form-label"></label>
        <textarea asp-for="EnglishDescription" class="form-control" rows="3" lang="en"></textarea>
    </div>
    <div>
        <label asp-for="EnglishMaterials" class="form-label"></label>
        <textarea asp-for="EnglishMaterials" class="form-control" rows="2" lang="en"></textarea>
        <span asp-validation-for="EnglishMaterials" class="text-danger small"></span>
    </div>
</details>

<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <label asp-for="WidthCm" class="form-label"></label>
        <input asp-for="WidthCm" class="form-control" type="number" min="0.01" max="100000" step="0.01" />
        <span asp-validation-for="WidthCm" class="text-danger small"></span>
    </div>
    <div class="col-sm-4">
        <label asp-for="HeightCm" class="form-label"></label>
        <input asp-for="HeightCm" class="form-control" type="number" min="0.01" max="100000" step="0.01" />
        <span asp-validation-for="HeightCm" class="text-danger small"></span>
    </div>
    <div class="col-sm-4">
        <label asp-for="DepthCm" class="form-label"></label>
        <input asp-for="DepthCm" class="form-control" type="number" min="0.01" max="100000" step="0.01" />
        <span asp-validation-for="DepthCm" class="text-danger small"></span>
    </div>
    <div class="form-text mt-2">Размерите и материалите са незадължителни. Попълнените стойности се показват в продуктовата страница.</div>
</div>

<div class="row g-3 mb-3">
    <div class="col-sm-6">
        <label asp-for="Price" class="form-label fw-semibold"></label>
        <div class="input-group">
            <input readonly="@(!await StaffAccess.HasPermissionAsync(User, "Products.ChangePrice"))" asp-for="Price" class="form-control" type="number" step="0.01" min="0" />
            <span class="input-group-text">€</span>
        </div>
        <span asp-validation-for="Price" class="text-danger small"></span>
    </div>
    <div class="col-sm-6">
        <label asp-for="CategoryN" class="form-label fw-semibold"></label>
        <select asp-for="CategoryN" id="productCategorySelect" data-subcategories-url="@Url.Action("GetSubCategories", "Admin", new { n = 0 })"
                asp-items="@(new SelectList(Model.Categories, "N", "Name", Model.CategoryN))"
                class="form-select">
            <option value="">— Без категория —</option>
        </select>
        <span asp-validation-for="CategoryN" class="text-danger small"></span>
    </div>
</div>

@* Под-категории *@
<div class="mb-3" id="subcategorySection">
    <label class="form-label fw-semibold">Под-категории</label>
    <span asp-validation-for="SelectedSubCategoryNs" class="text-danger small d-block"></span>
    <div id="subcategoryCheckboxes" class="border rounded p-3 bg-light" style="min-height:50px;">
        @if (Model.AvailableSubCategories.Any())
        {
            @foreach (var sub in Model.AvailableSubCategories)
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox"
                           name="SelectedSubCategoryNs" value="@sub.N"
                           id="sub_@sub.N"
                           @(Model.SelectedSubCategoryNs.Contains(sub.N) ? "checked" : "") />
                    <label class="form-check-label" for="sub_@sub.N">@sub.Name</label>
                </div>
            }
        }
        else if (Model.CategoryN.HasValue)
        {
            <p class="text-muted small mb-0">Няма под-категории за тази категория.</p>
        }
        else
        {
            <p class="text-muted small mb-0">Изберете категория за да видите под-категориите.</p>
        }
    </div>
</div>

@await Html.PartialAsync("_ProductVariants", Model)

<section class="algara-image-editor border rounded p-3 mb-4" aria-labelledby="galleryHeading"
         data-product-gallery data-product-n="@Model.N" data-draft-id="@Model.GalleryDraftId"
         data-upload-url="@Url.Content("~/admin/products/images/upload")"
         data-delete-url="@Url.Content("~/admin/products/images/delete")">
    <input type="hidden" name="GalleryDraftId" value="@Model.GalleryDraftId" />
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
        <h2 id="galleryHeading" class="h6 fw-semibold mb-0">Снимки на продукта</h2>
        <span class="text-muted small" data-gallery-count>@Model.Images.Count / 20</span>
    </div>
    <p class="text-muted small mb-2">Снимките се качват и изтриват веднага. Подредбата и основната снимка се запазват с „Запиши“.</p>
    <p id="galleryInstructions" class="text-muted small mb-3">Преместете снимките с влачене или със стрелките. Първата вляво е основна.</p>
    <span asp-validation-for="Images" class="text-danger small d-block"></span>
    <div class="alert alert-danger small" role="alert" data-gallery-error hidden></div>
    <ol class="algara-image-grid" aria-label="Галерия на продукта" aria-describedby="galleryInstructions" data-gallery-list>
        @for (var i = 0; i < Model.Images.Count; i++)
        {
            <li class="algara-image-tile @(i == 0 ? "is-main" : "")" data-gallery-item
                draggable="true" tabindex="0" aria-label="Снимка @(i + 1)@(i == 0 ? ", основна" : "")">
                <input type="hidden" name="Images[@i].N" value="@Model.Images[i].N" data-image-field="N" />
                <input type="hidden" name="Images[@i].UploadId" value="@Model.Images[i].UploadId" data-image-field="UploadId" />
                <input type="hidden" name="Images[@i].DisplayOrder" value="@i" data-image-field="DisplayOrder" />
                <img src="@Model.Images[i].ImageUrl" alt="Снимка @(i + 1)" draggable="false" />
                <span class="algara-image-main" data-image-main>Основна</span>
                <button type="button" class="algara-image-delete" data-image-delete
                        title="Изтрий снимка @(i + 1)" aria-label="Изтрий снимка @(i + 1)">×</button>
                <div class="algara-image-moves">
                    <button type="button" data-image-move="-1" title="Премести наляво" aria-label="Премести снимка @(i + 1) наляво" disabled="@(i == 0)">←</button>
                    <span class="algara-image-position" data-image-position>@(i + 1)</span>
                    <button type="button" data-image-move="1" title="Премести надясно" aria-label="Премести снимка @(i + 1) надясно" disabled="@(i == Model.Images.Count - 1)">→</button>
                </div>
            </li>
        }
    </ol>
    <p class="text-muted small mb-3" data-gallery-empty hidden="@(Model.Images.Count > 0)">Все още няма снимки. Първата качена снимка ще бъде основна.</p>
    <div class="mt-3">
        <label for="productImageUpload" class="form-label fw-semibold">Качи снимки</label>
        <input id="productImageUpload" type="file" multiple accept="image/jpeg,image/png,image/webp" class="form-control"
               aria-describedby="productImageUploadHelp" data-product-image-input />
        <div id="productImageUploadHelp" class="form-text">JPG, PNG или WebP, до 5 MB на файл и до 20 снимки в галерията.</div>
    </div>
    <p class="small mb-0 mt-2" role="status" aria-live="polite" data-gallery-status></p>
    <noscript><p class="text-danger small mt-2">За качване, изтриване и подреждане на снимки е необходим JavaScript.</p></noscript>
</section>
<div class="d-flex flex-wrap gap-4 mt-2">
    <div class="form-check">
        <input class="form-check-input" asp-for="IsCustomizable" />
        <label class="form-check-label" asp-for="IsCustomizable">Възможност за индивидуална поръчка</label>
    </div>
    <div class="form-check">
        <input class="form-check-input" asp-for="IsFeatured" />
        <label class="form-check-label" asp-for="IsFeatured">Препоръчан на начална страница</label>
    </div>
    <div class="form-check">
        @if (!canChangeActive) { <input type="hidden" name="IsActive" value="@Model.IsActive.ToString().ToLowerInvariant()" /> }
<input disabled="@(!canChangeActive)" class="form-check-input" asp-for="IsActive" />
        <label class="form-check-label" asp-for="IsActive">Активен (видим в каталога)</label>
    </div>
</div>
