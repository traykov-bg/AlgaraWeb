@model Algara.Web.ViewModels.Admin.AdminDashboardViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Табло";
}

<div class="row g-3 mb-4">
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card text-center border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="fs-2 text-primary mb-1"><i class="bi bi-box-seam"></i></div>
                <div class="fs-3 fw-bold">@Model.TotalActiveProducts</div>
                <div class="text-muted small">Активни продукти</div>
            </div>
            <div class="card-footer bg-transparent border-0 pb-3">
                <a asp-controller="Admin" asp-action="Products" class="btn btn-sm btn-outline-primary w-100">Управление</a>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card text-center border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="fs-2 text-info mb-1"><i class="bi bi-tags"></i></div>
                <div class="fs-3 fw-bold">@Model.TotalCategories</div>
                <div class="text-muted small">Категории</div>
            </div>
            <div class="card-footer bg-transparent border-0 pb-3">
                <a asp-controller="Admin" asp-action="Categories" class="btn btn-sm btn-outline-info w-100">Управление</a>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card text-center border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="fs-2 text-secondary mb-1"><i class="bi bi-bag-check"></i></div>
                <div class="fs-3 fw-bold">@Model.TotalOrders</div>
                <div class="text-muted small">Общо поръчки</div>
            </div>
            <div class="card-footer bg-transparent border-0 pb-3">
                <a asp-controller="Admin" asp-action="Orders" class="btn btn-sm btn-outline-secondary w-100">Управление</a>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card text-center border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="fs-2 text-warning mb-1"><i class="bi bi-hourglass-split"></i></div>
                <div class="fs-3 fw-bold">@Model.OrdersPending</div>
                <div class="text-muted small">Чакащи поръчки</div>
            </div>
            <div class="card-footer bg-transparent border-0 pb-3">
                <a asp-controller="Admin" asp-action="Orders" asp-route-status="0" class="btn btn-sm btn-outline-warning w-100">Виж</a>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card text-center border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="fs-2 text-success mb-1"><i class="bi bi-check-circle"></i></div>
                <div class="fs-3 fw-bold">@Model.OrdersDelivered</div>
                <div class="text-muted small">Доставени</div>
            </div>
            <div class="card-footer bg-transparent border-0 pb-3">
                <a asp-controller="Admin" asp-action="Orders" asp-route-status="3" class="btn btn-sm btn-outline-success w-100">Виж</a>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card text-center border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="fs-2 text-dark mb-1"><i class="bi bi-people"></i></div>
                <div class="fs-3 fw-bold">@Model.TotalUsers</div>
                <div class="text-muted small">Потребители</div>
            </div>
            <div class="card-footer bg-transparent border-0 pb-3">
                <a asp-controller="Admin" asp-action="Users" class="btn btn-sm btn-outline-dark w-100">Управление</a>
            </div>
        </div>
    </div>
</div>

<!-- Бърз статус на поръчките -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white fw-semibold">Поръчки по статус</div>
    <div class="card-body">
        <div class="row g-3 text-center">
            <div class="col"><span class="badge bg-warning text-dark fs-6">@Model.OrdersPending</span><br><small>Чакащи</small></div>
            <div class="col"><span class="badge bg-primary fs-6">@Model.OrdersConfirmed</span><br><small>Потвърдени</small></div>
            <div class="col"><span class="badge bg-info text-dark fs-6">@Model.OrdersShipped</span><br><small>Изпратени</small></div>
            <div class="col"><span class="badge bg-success fs-6">@Model.OrdersDelivered</span><br><small>Доставени</small></div>
            <div class="col"><span class="badge bg-secondary fs-6">@Model.OrdersCancelled</span><br><small>Отказани</small></div>
        </div>
    </div>
</div>
