@model Algara.Web.ViewModels.Admin.AdminProductListViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Продукти";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <span class="text-muted small">Страница @Model.CurrentPage от @Model.TotalPages</span>
    <a asp-action="ProductCreate" class="btn btn-sm btn-primary">
        <i class="bi bi-plus-lg me-1"></i>Нов продукт
    </a>
</div>

<style>
    .sort-check {
        border: 2px solid #0d6efd;
        box-shadow: 0 0 0 2px rgba(13,110,253,.18);
        cursor: pointer;
    }
    .sort-check:checked {
        background-color: #0d6efd;
        border-color: #0d6efd;
        box-shadow: 0 0 0 3px rgba(13,110,253,.30);
    }
</style>

<input type="hidden" id="currentSort" value="@Model.Sort" />
<input type="hidden" id="baseUrl" value="@Url.Action("Products")" />

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover table-sm mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th data-col="n" style="white-space:nowrap;">
                        <input type="checkbox" class="sort-check form-check-input me-1" title="Сортирай по #" />
                        #
                        <button class="sort-dir btn btn-link p-0 ms-1" style="font-size:.85rem;" title="Обърни посоката"><i class="bi bi-arrow-up text-primary"></i></button>
                        <sup class="sort-badge fw-semibold text-primary" style="font-size:.6rem;"></sup>
                    </th>
                    <th data-col="name" style="white-space:nowrap;">
                        <input type="checkbox" class="sort-check form-check-input me-1" title="Сортирай по наименование" />
                        Наименование
                        <button class="sort-dir btn btn-link p-0 ms-1" style="font-size:.85rem;" title="Обърни посоката"><i class="bi bi-arrow-up text-primary"></i></button>
                        <sup class="sort-badge fw-semibold text-primary" style="font-size:.6rem;"></sup>
                    </th>
                    <th data-col="category" style="white-space:nowrap;">
                        <input type="checkbox" class="sort-check form-check-input me-1" title="Сортирай по категория" />
                        Категория
                        <button class="sort-dir btn btn-link p-0 ms-1" style="font-size:.85rem;" title="Обърни посоката"><i class="bi bi-arrow-up text-primary"></i></button>
                        <sup class="sort-badge fw-semibold text-primary" style="font-size:.6rem;"></sup>
                    </th>
                    <th data-col="price" class="text-end" style="white-space:nowrap;">
                        <input type="checkbox" class="sort-check form-check-input me-1" title="Сортирай по цена" />
                        Цена
                        <button class="sort-dir btn btn-link p-0 ms-1" style="font-size:.85rem;" title="Обърни посоката"><i class="bi bi-arrow-up text-primary"></i></button>
                        <sup class="sort-badge fw-semibold text-primary" style="font-size:.6rem;"></sup>
                    </th>
                    <th data-col="featured" class="text-center" style="white-space:nowrap;">
                        <input type="checkbox" class="sort-check form-check-input me-1" title="Сортирай по препоръчан" />
                        Препоръчан
                        <button class="sort-dir btn btn-link p-0 ms-1" style="font-size:.85rem;" title="Обърни посоката"><i class="bi bi-arrow-up text-primary"></i></button>
                        <sup class="sort-badge fw-semibold text-primary" style="font-size:.6rem;"></sup>
                    </th>
                    <th data-col="status" class="text-center" style="white-space:nowrap;">
                        <input type="checkbox" class="sort-check form-check-input me-1" title="Сортирай по статус" />
                        Статус
                        <button class="sort-dir btn btn-link p-0 ms-1" style="font-size:.85rem;" title="Обърни посоката"><i class="bi bi-arrow-up text-primary"></i></button>
                        <sup class="sort-badge fw-semibold text-primary" style="font-size:.6rem;"></sup>
                    </th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Products)
                {
                    <tr class="@(!p.IsActive ? "table-secondary text-muted" : "")">
                        <td class="text-muted small">@p.N</td>
                        <td>
                            <span class="fw-semibold">@p.Name</span>
                            @if (p.IsCustomizable)
                            {
                                <span class="badge bg-light text-secondary border ms-1" style="font-size:.65rem;">По поръчка</span>
                            }
                        </td>
                        <td class="small text-muted">@(p.Category?.Name ?? "—")</td>
                        <td class="text-end small">@p.Price.ToString("N0") €</td>
                        <td class="text-center">
                            @if (p.IsFeatured) { <i class="bi bi-star-fill text-warning"></i> }
                        </td>
                        <td class="text-center">
                            @if (p.IsActive)
                            {
                                <span class="badge bg-success">Активен</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Неактивен</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="ProductEdit" asp-route-n="@p.N"
                               class="btn btn-xs btn-outline-primary me-1" style="padding:.2rem .5rem;font-size:.78rem;">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-action="ProductToggle" asp-route-n="@p.N" method="post" class="d-inline">
                                <button type="submit" class="btn btn-xs @(p.IsActive ? "btn-outline-secondary" : "btn-outline-success")"
                                        style="padding:.2rem .5rem;font-size:.78rem;"
                                        title="@(p.IsActive ? "Деактивирай" : "Активирай")">
                                    <i class="bi @(p.IsActive ? "bi-eye-slash" : "bi-eye")"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Products.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">Няма продукти.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination pagination-sm justify-content-center mb-0">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Products" asp-route-page="@i" asp-route-sort="@Model.Sort">@i</a>
                </li>
            }
        </ul>
    </nav>
}

@section Scripts {
<script>
(function () {
    var currentSort = document.getElementById('currentSort').value;
    var baseUrl     = document.getElementById('baseUrl').value;

    // Parse sort string into ordered array: [{col, dir}, ...]
    var sortOrder = [];
    if (currentSort) {
        currentSort.split(',').forEach(function (part) {
            var p = part.trim().split('_');
            if (p[0]) sortOrder.push({ col: p[0], dir: p[1] === 'desc' ? 'desc' : 'asc' });
        });
    }

    function refreshUI() {
        document.querySelectorAll('th[data-col]').forEach(function (th) {
            var col    = th.dataset.col;
            var check  = th.querySelector('.sort-check');
            var dirBtn = th.querySelector('.sort-dir');
            var badge  = th.querySelector('.sort-badge');
            var idx    = sortOrder.findIndex(function (s) { return s.col === col; });

            if (idx !== -1) {
                var entry = sortOrder[idx];
                check.checked        = true;
                dirBtn.style.display = '';
                dirBtn.querySelector('i').className =
                    'bi text-primary ' + (entry.dir === 'desc' ? 'bi-arrow-down' : 'bi-arrow-up');
                badge.textContent    = sortOrder.length > 1 ? (idx + 1) : '';
                badge.style.display  = sortOrder.length > 1 ? '' : 'none';
            } else {
                check.checked        = false;
                dirBtn.style.display = 'none';
                badge.style.display  = 'none';
            }
        });
    }

    function navigate() {
        var sortStr = sortOrder.map(function (s) { return s.col + '_' + s.dir; }).join(',');
        if (!sortStr) sortStr = 'name_asc';
        window.location.href = baseUrl + '?page=1&sort=' + encodeURIComponent(sortStr);
    }

    document.querySelectorAll('th[data-col]').forEach(function (th) {
        var col   = th.dataset.col;
        var check = th.querySelector('.sort-check');
        var btn   = th.querySelector('.sort-dir');

        check.addEventListener('change', function (e) {
            e.stopPropagation();
            if (this.checked) {
                sortOrder.push({ col: col, dir: 'asc' });
            } else {
                sortOrder = sortOrder.filter(function (s) { return s.col !== col; });
            }
            navigate();
        });

        btn.addEventListener('click', function (e) {
            e.stopPropagation();
            var entry = sortOrder.find(function (s) { return s.col === col; });
            if (entry) {
                entry.dir = entry.dir === 'asc' ? 'desc' : 'asc';
                navigate();
            }
        });
    });

    refreshUI();
}());
</script>
}
