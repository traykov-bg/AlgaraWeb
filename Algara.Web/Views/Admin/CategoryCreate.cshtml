@model Algara.Web.ViewModels.Admin.AdminCategoryFormViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Нова категория";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
                {
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>
                }
                <form asp-action="CategoryCreate" method="post">
                    @await Html.PartialAsync("_CategoryFormFields", Model)
                    <div class="alert alert-info small mt-3 mb-0">
                        <i class="bi bi-info-circle me-1"></i>
                        Под-категориите могат да се добавят след запис на категорията.
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-floppy me-1"></i>Запиши
                        </button>
                        <a asp-action="Categories" class="btn btn-outline-secondary">Откажи</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
