@model Algara.Data.Models.Product
@inject Microsoft.Extensions.Localization.IStringLocalizer<Algara.Web.Localization.CatalogResources> T

@{
    var productName = Model.GetName();
    var description = Model.GetDescription();
    var materials = Model.GetMaterials();
    var images = Model.Images.OrderBy(image => image.DisplayOrder).ThenBy(image => image.N)
        .Select(image => image.ImageUrl).ToList();
    if (images.Count == 0 && !string.IsNullOrWhiteSpace(Model.ImageUrl))
        images.Add(Model.ImageUrl);
    ViewData["Title"] = productName;
    var pricingAt     = DateTime.Now;
    ViewData["VariantPricingAt"] = pricingAt;
    var selectedVariant = Model.GetSelectableVariants()
        .FirstOrDefault(variant => variant.N == (int?)ViewData["SelectedVariantN"]) ?? Model.GetDefaultVariant();
    var activePromo   = Model.GetActivePromotion(pricingAt);
    var discount      = Model.GetActiveDiscount(pricingAt);
    var discountLabel = Model.GetDiscountLabel(pricingAt);
    var finalPrice    = selectedVariant == null ? Model.GetDiscountedPrice(pricingAt) : Model.GetVariantPrice(selectedVariant, pricingAt);
    var originalPrice = selectedVariant == null ? activePromo?.OriginalPrice ?? Model.Price : Model.GetVariantOriginalPrice(selectedVariant, pricingAt);
    var mainImage = Model.GetVariantImageUrl(selectedVariant);
    var exactVariantImage = selectedVariant?.ProductImageN != null && Model.Images.Any(image => image.N == selectedVariant.ProductImageN);
    var promoNote     = activePromo?.Note;
}

@section Styles {
    <link rel="stylesheet" href="~/css/product-variants.css" asp-append-version="true" />
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">@T["Catalog"]</a></li>
        @if (Model.Category != null)
        {
            <li class="breadcrumb-item">
                <a asp-action="Category" asp-route-slug="@Model.Category.Slug">@Model.Category.Name</a>
            </li>
        }
        <li class="breadcrumb-item active" aria-current="page">@productName</li>
    </ol>
</nav>

<div class="row g-4" data-product-detail>
    <div class="col-md-5">
        <div class="algara-product-gallery" data-product-gallery>
            <div class="position-relative">
                @if (!string.IsNullOrWhiteSpace(mainImage))
                {
                    <img src="@mainImage" class="algara-product-gallery__main img-fluid rounded shadow-sm"
                         alt="@productName" data-gallery-main />
                }
                else
                {
                    <div class="bg-light rounded d-flex align-items-center justify-content-center algara-product-gallery__empty">
                        <span class="text-muted">@T["NoImage"]</span>
                    </div>
                }
                @if (discount.HasValue)
                {
                    <span class="position-absolute top-0 start-0 m-2 d-flex align-items-center justify-content-center
                                 bg-danger text-white fw-bold rounded-circle shadow"
                          style="width:54px;height:54px;font-size:.9rem;" title="@(Model.OptionKind == ProductOptionKind.None ? "" : T["PromotionBaseOnly"].Value)">
                        @discountLabel
                    </span>
                }
            </div>
            @if (images.Count > 1)
            {
                <div class="algara-product-gallery__thumbnails mt-3" role="group" aria-label="@T["Gallery"]">
                    @for (var index = 0; index < images.Count; index++)
                    {
                        <button type="button" class="algara-product-gallery__thumbnail @(images[index] == mainImage ? "is-selected" : "")"
                                data-gallery-src="@Url.Content(images[index])" aria-pressed="@(images[index] == mainImage ? "true" : "false")"
                                aria-label="@T["ImageNumber", index + 1, images.Count]">
                            <img src="@images[index]" alt="" loading="lazy" />
                        </button>
                    }
                </div>
            }
            @if (Model.OptionKind != ProductOptionKind.None)
            {
                <p class="small text-muted mt-2" data-variant-photo-note>
                    @T[string.IsNullOrWhiteSpace(mainImage) ? "NoImage" : exactVariantImage ? "ExactVariantPhoto" : "BaseProductPhoto"]
                </p>
            }
        </div>
    </div>
    <div class="col-md-7">
        <h2>@productName</h2>
        <p class="text-muted small">@T["Sku"]: <strong>@Model.Sku</strong></p>
        @if (Model.Category != null)
        {
            <p class="text-muted">
                <a asp-action="Category" asp-route-slug="@Model.Category.Slug">@Model.Category.Name</a>
            </p>
        }
        @if (discount.HasValue)
        {
            <div class="my-3">
                <span class="h4 fw-bold text-danger me-2" data-variant-price>@finalPrice.ToString("N2") €</span>
                <span class="text-muted text-decoration-line-through" data-variant-original>@originalPrice.ToString("N2") €</span>
            </div>
        }
        else
        {
            <h4 class="my-3" data-variant-price>@finalPrice.ToString("N2") €</h4>
        }
        @if (!string.IsNullOrWhiteSpace(promoNote))
        {
            <p class="fw-bold text-danger mb-3">
                <i class="bi bi-gift-fill me-1"></i>@promoNote
            </p>
        }
        @if (Model.OptionKind != ProductOptionKind.None)
        {
            @await Html.PartialAsync("_ProductVariantPicker", Model)
        }
        else
        {
            <p class="fw-semibold">@T["Availability" + Model.GetAvailability()]</p>
        }
        <p class="small"><a asp-controller="Home" asp-action="Delivery">@T["DeliveryTerms"]</a></p>
        @if (!string.IsNullOrWhiteSpace(description))
        {
            <p class="algara-product-description">@description</p>
        }
        @if (Model.WidthCm.HasValue || Model.HeightCm.HasValue || Model.DepthCm.HasValue)
        {
            <h3 class="h6 mt-4">@T["Dimensions"]</h3>
            <dl class="row small">
                @if (Model.WidthCm.HasValue)
                {
                    <dt class="col-5">@T["Width"]</dt>
                    <dd class="col-7">@Model.WidthCm.Value.ToString("0.##") @T["Cm"]</dd>
                }
                @if (Model.HeightCm.HasValue)
                {
                    <dt class="col-5">@T["Height"]</dt>
                    <dd class="col-7">@Model.HeightCm.Value.ToString("0.##") @T["Cm"]</dd>
                }
                @if (Model.DepthCm.HasValue)
                {
                    <dt class="col-5">@T["Depth"]</dt>
                    <dd class="col-7">@Model.DepthCm.Value.ToString("0.##") @T["Cm"]</dd>
                }
            </dl>
        }
        @if (!string.IsNullOrWhiteSpace(materials))
        {
            <h3 class="h6 mt-4">@T["Materials"]</h3>
            <p class="algara-product-description">@materials</p>
        }
        <hr />
        <a asp-action="Index" class="btn btn-outline-secondary">← @T["BackToCatalog"]</a>
    </div>
</div>

@section Scripts {
    <script src="~/js/product-gallery.js" asp-append-version="true"></script>
    <script src="~/js/product-variants.js" asp-append-version="true"></script>
}
