@model IEnumerable<Algara.Data.Models.Product>

@{
    var searchQuery = ViewBag.SearchQuery as string;
    var categoryName = ViewBag.CategoryName as string;
    var categorySlug = ViewBag.CategorySlug as string;
    ViewData["Title"] = categoryName ?? "Каталог";
    var categories = ViewBag.Categories as IEnumerable<Algara.Data.Models.Category>;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0">@ViewData["Title"]</h2>
        @if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            <p class="text-muted small mt-1">
                Резултати за: <strong>@searchQuery</strong> &nbsp;
                <a asp-action="Index" class="text-muted"><i class="bi bi-x-circle"></i> Изчисти</a>
            </p>
        }
    </div>
</div>

@if (categories != null && categories.Any())
{
    <div class="mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-1">Всички</a>
        @foreach (var cat in categories)
        {
            <a asp-action="Category" asp-route-slug="@cat.Slug"
               class="btn btn-sm me-1 @(categorySlug == cat.Slug ? "btn-primary" : "btn-outline-primary")">
                @cat.Name
            </a>
        }
    </div>
}

@if (!Model.Any())
{
    <p class="text-muted">Няма намерени продукти.</p>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var product in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                    {
                        <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name"
                             style="height: 200px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="card-img-top bg-light d-flex align-items-center justify-content-center"
                             style="height: 200px;">
                            <span class="text-muted">Без снимка</span>
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="card-title">@product.Name</h5>
                        @if (product.Category != null)
                        {
                            <p class="card-text text-muted small">@product.Category.Name</p>
                        }
                        @if (!string.IsNullOrEmpty(product.Description))
                        {
                            <p class="card-text small">
                                @(product.Description.Length > 80
                                    ? product.Description[..80] + "…"
                                    : product.Description)
                            </p>
                        }
                    </div>
                    <div class="card-footer d-flex justify-content-between align-items-center">
                        <strong>@product.Price.ToString("C")</strong>
                        <div>
                            @if (product.IsCustomizable)
                            {
                                <span class="badge bg-info me-1">По поръчка</span>
                            }
                            <a asp-action="Detail" asp-route-n="@product.N" class="btn btn-primary btn-sm">Детайли</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
