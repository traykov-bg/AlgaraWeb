@model Algara.Web.ViewModels.CatalogViewModel

@using Algara.Web.Helpers
@using System.Globalization
@inject Microsoft.Extensions.Localization.IStringLocalizer<Algara.Web.Localization.CatalogResources> T

@{
    ViewData["Title"] = Model.CategoryName ?? T["Catalog"].Value;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0">@ViewData["Title"]</h2>
        @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
        {
            <p class="text-muted small mt-1">
                @T["ResultsFor"] <strong>@Model.SearchQuery</strong> &nbsp;
                <a asp-action="Index" class="text-muted"><i class="bi bi-x-circle"></i> @T["Clear"]</a>
            </p>
        }
    </div>
</div>

@* Бутони за категории *@
@if (Model.Categories.Any())
{
    <div class="mb-3">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-1">@T["All"]</a>
        @foreach (var cat in Model.Categories)
        {
            <a asp-action="Category" asp-route-slug="@cat.Slug"
               class="btn btn-sm me-1 @(Model.CategorySlug == cat.Slug ? "btn-primary" : "btn-outline-primary")">
                @cat.Name
            </a>
        }
    </div>
}

@* Под-категории *@
@if (Model.SubCategories?.Any() == true && Model.CategorySlug != null)
{
    <div class="mb-4 d-flex flex-wrap align-items-center gap-1">
        <span class="text-muted small me-1 fw-semibold">@T["Subcategory"]</span>
        <a href="/kategorii/@Model.CategorySlug@(CatalogQueryString.ForSubcategory(Model, null))"
           class="btn btn-sm me-1 @(Model.ActiveSubSlug == null ? "btn-secondary" : "btn-outline-secondary")">
            @T["All"]
        </a>
        @foreach (var sub in Model.SubCategories)
        {
            <a href="/kategorii/@Model.CategorySlug@(CatalogQueryString.ForSubcategory(Model, sub.Slug))"
               class="btn btn-sm me-1 @(Model.ActiveSubSlug == sub.Slug ? "btn-primary" : "btn-outline-primary")">
                @sub.Name
            </a>
        }
    </div>
}

@* Филтри: цена + сортиране + продукти на страница *@
<form method="get" id="filterForm" class="mb-4">
    @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
    {
        <input type="hidden" name="q" value="@Model.SearchQuery" />
    }
    @if (Model.CategorySlug != null && Model.ActiveSubSlug != null)
    {
        <input type="hidden" name="sub" value="@Model.ActiveSubSlug" />
    }
    <input type="hidden" name="page" value="1" />

    <div class="card border-0 bg-light rounded-3 px-3 py-2">
        <div class="d-flex flex-wrap align-items-end gap-3">

            @* Цена От *@
            <div>
                <label class="form-label mb-1 small text-muted fw-semibold">@T["PriceFrom"]</label>
                <input type="number" name="minPrice" id="minPrice" class="form-control form-control-sm"
                       style="width:100px" min="0" step="0.01"
                       value="@Model.MinPrice?.ToString(CultureInfo.InvariantCulture)"
                       placeholder="@Model.RangeMin.ToString("F2", CultureInfo.InvariantCulture)" />
            </div>

            @* Цена До *@
            <div>
                <label class="form-label mb-1 small text-muted fw-semibold">@T["PriceTo"]</label>
                <input type="number" name="maxPrice" id="maxPrice" class="form-control form-control-sm"
                       style="width:100px" min="0" step="0.01"
                       value="@Model.MaxPrice?.ToString(CultureInfo.InvariantCulture)"
                       placeholder="@Model.RangeMax.ToString("F2", CultureInfo.InvariantCulture)" />
            </div>

            @* Бутони Приложи / Изчисти *@
            <div class="d-flex gap-2 align-items-end">
                <button type="submit" class="btn btn-primary btn-sm">@T["Apply"]</button>
                <button type="button" class="btn btn-outline-secondary btn-sm"
                        onclick="document.getElementById('minPrice').value='';document.getElementById('maxPrice').value='';document.getElementById('filterForm').submit()">
                    <i class="bi bi-x"></i> @T["Clear"]
                </button>
            </div>

            @* Разделител *@
            <div class="vr d-none d-md-block align-self-stretch my-1"></div>

            @* Сортиране *@
            <div class="ms-md-auto">
                <label class="form-label mb-1 small text-muted fw-semibold">@T["Sort"]</label>
                <select name="sort" class="form-select form-select-sm" style="width:auto"
                        onchange="this.form.submit()">
                    <!option value="newest"    @(Model.Sort == "newest"    ? "selected" : "")>@T["Newest"]</!option>
                    <!option value="name_asc"  @(Model.Sort == "name_asc"  ? "selected" : "")>@T["NameAscending"]</!option>
                    <!option value="name_desc" @(Model.Sort == "name_desc" ? "selected" : "")>@T["NameDescending"]</!option>
                    <!option value="price_asc" @(Model.Sort == "price_asc" ? "selected" : "")>@T["PriceAscending"]</!option>
                    <!option value="price_desc"@(Model.Sort == "price_desc"? "selected" : "")>@T["PriceDescending"]</!option>
                </select>
            </div>

            @* Продукти на страница *@
            <div>
                <label class="form-label mb-1 small text-muted fw-semibold">@T["PerPage"]</label>
                <select name="pageSize" class="form-select form-select-sm" style="width:auto"
                        onchange="this.form.submit()">
                    @foreach (var ps in Algara.Web.ViewModels.CatalogViewModel.PageSizeOptions)
                    {
                        <!option value="@ps" @(Model.PageSize == ps ? "selected" : "")>@ps</!option>
                    }
                </select>
            </div>

        </div>
    </div>
</form>

@* Брой резултати *@
<div class="d-flex justify-content-between align-items-center mb-3">
    <span class="text-muted small">
        @if (Model.TotalCount == 0)
        {
            <span>@T["NoProducts"]</span>
        }
        else
        {
            var from = (Model.Page - 1) * Model.PageSize + 1;
            var to   = Math.Min(Model.Page * Model.PageSize, Model.TotalCount);
            <span>@T["ResultsCount", from, to, Model.TotalCount]</span>
        }
    </span>
</div>

<style>
    .promo-note-clamp {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
        word-break: break-word;
    }

    .product-card-link {
        transition: transform .15s ease, box-shadow .15s ease;
    }

    .product-card-link:hover {
        transform: translateY(-2px);
        box-shadow: 0 .5rem 1rem rgba(0, 0, 0, .12) !important;
    }
</style>

@if (!Model.Products.Any())
{
    <p class="text-muted">@T["NoProducts"]</p>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var product in Model.Products)
        {
            var activePromo   = product.GetActivePromotion(Model.PricingAt);
            var discount      = product.GetActiveDiscount(Model.PricingAt);
            var discountLabel = product.GetDiscountLabel(Model.PricingAt);
            var finalPrice    = product.GetCatalogPrice(Model.PricingAt);
            var promoNote     = activePromo?.Note;
            var productName = product.GetName();
            var description = product.GetDescription();
            var imageUrl = product.GetMainImageUrl();
            <div class="col">
                <a asp-action="Detail" asp-route-n="@product.N"
                   class="card h-100 shadow-sm text-decoration-none text-reset product-card-link">
                    <div class="position-relative">
                        @if (!string.IsNullOrEmpty(imageUrl))
                        {
                            <img src="@imageUrl" class="card-img-top" alt="@productName"
                                 style="height: 200px; object-fit: cover;" loading="lazy" />
                        }
                        else
                        {
                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center"
                                 style="height: 200px;">
                                <span class="text-muted">@T["NoImage"]</span>
                            </div>
                        }
                        @if (discount.HasValue)
                        {
                            <span class="position-absolute top-0 start-0 m-2 d-flex align-items-center justify-content-center
                                         bg-danger text-white fw-bold rounded-circle shadow"
                                  style="width:46px;height:46px;font-size:.8rem;">
                                @discountLabel
                            </span>
                        }
                    </div>
                    <div class="card-body">
                        <h5 class="card-title">@productName</h5>
                        <p class="card-text text-muted small">@T["Sku"]: @product.Sku</p>
                        @if (product.Category != null)
                        {
                            <p class="card-text text-muted small">@product.Category.Name</p>
                        }
                        @if (!string.IsNullOrEmpty(description))
                        {
                            <p class="card-text small">
                                @(description.Length > 80
                                    ? description[..80] + "…"
                                    : description)
                            </p>
                        }
                        @if (!string.IsNullOrWhiteSpace(promoNote))
                        {
                            <p class="card-text small fw-bold text-danger mb-0 promo-note-clamp"
                               title="@promoNote">
                                @promoNote
                            </p>
                        }
                    </div>
                    <div class="card-footer d-flex justify-content-between align-items-center">
                        <div>
                            @if (discount.HasValue)
                            {
                                <span class="fw-bold text-danger me-1">@(product.OptionKind != ProductOptionKind.None ? T["StartingAt"].Value + " " : "")@finalPrice.ToString("N2") €</span>
                                <span class="text-muted text-decoration-line-through small">@(product.GetCatalogOriginalPrice(Model.PricingAt).ToString("N2")) €</span>
                            }
                            else
                            {
                                <strong>@(product.OptionKind != ProductOptionKind.None ? T["StartingAt"].Value + " " : "")@finalPrice.ToString("N2") €</strong>
                            }
                        </div>
                        @if (discount.HasValue && product.OptionKind != ProductOptionKind.None)
                        {
                            <small class="text-muted ms-2">@T["PromotionBaseOnly"]</small>
                        }
                        @if (product.GetAvailability(product.GetDefaultVariant()) == ProductAvailability.MadeToOrder)
                        {
                            <span class="badge bg-info">@T["MadeToOrder"]</span>
                        }
                    </div>
                </a>
            </div>
        }
    </div>

    @* Пагинация *@
    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4" aria-label="@T["Pagination"]">
            <ul class="pagination justify-content-center flex-wrap">

                @* Предишна *@
                <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                    <a class="page-link" href="@CatalogQueryString.ForPage(Model, Model.Page - 1)" aria-label="@T["Previous"]">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>

                @* Номера на страници *@
                @{
                    int startPage = Math.Max(1, Model.Page - 2);
                    int endPage   = Math.Min(Model.TotalPages, Model.Page + 2);
                }
                @if (startPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="@CatalogQueryString.ForPage(Model, 1)">1</a>
                    </li>
                    @if (startPage > 2)
                    {
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                    }
                }
                @for (int p = startPage; p <= endPage; p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")">
                        <a class="page-link" href="@CatalogQueryString.ForPage(Model, p)">@p</a>
                    </li>
                }
                @if (endPage < Model.TotalPages)
                {
                    @if (endPage < Model.TotalPages - 1)
                    {
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                    }
                    <li class="page-item">
                        <a class="page-link" href="@CatalogQueryString.ForPage(Model, Model.TotalPages)">@Model.TotalPages</a>
                    </li>
                }

                @* Следваща *@
                <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="@CatalogQueryString.ForPage(Model, Model.Page + 1)" aria-label="@T["Next"]">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>

            </ul>
        </nav>
    }
}
