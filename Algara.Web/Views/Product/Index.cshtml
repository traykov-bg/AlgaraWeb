@model IEnumerable<Algara.Data.Models.Product>

@{
    var searchQuery    = ViewBag.SearchQuery as string;
    var categoryName   = ViewBag.CategoryName as string;
    var categorySlug   = ViewBag.CategorySlug as string;
    var subCategories  = ViewBag.SubCategories as List<Algara.Data.Models.SubCategory>;
    var activeSubSlug  = ViewBag.ActiveSubSlug as string;
    var currentSort    = ViewBag.Sort as string ?? "newest";
    ViewData["Title"]  = categoryName ?? "Каталог";
    var categories     = ViewBag.Categories as IEnumerable<Algara.Data.Models.Category>;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0">@ViewData["Title"]</h2>
        @if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            <p class="text-muted small mt-1">
                Резултати за: <strong>@searchQuery</strong> &nbsp;
                <a asp-action="Index" class="text-muted"><i class="bi bi-x-circle"></i> Изчисти</a>
            </p>
        }
    </div>
</div>

@* Бутони за категории *@
@if (categories != null && categories.Any())
{
    <div class="mb-3">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-1">Всички</a>
        @foreach (var cat in categories)
        {
            <a asp-action="Category" asp-route-slug="@cat.Slug"
               class="btn btn-sm me-1 @(categorySlug == cat.Slug ? "btn-primary" : "btn-outline-primary")">
                @cat.Name
            </a>
        }
    </div>
}

@* Под-категории — показват се само когато сме в контекста на категория *@
@if (subCategories != null && subCategories.Any() && categorySlug != null)
{
    <div class="mb-4 d-flex flex-wrap align-items-center gap-1">
        <span class="text-muted small me-1 fw-semibold">Под-категория:</span>
        <a href="/kategorii/@categorySlug"
           class="btn btn-sm me-1 @(activeSubSlug == null ? "btn-secondary" : "btn-outline-secondary")">
            Всички
        </a>
        @foreach (var sub in subCategories)
        {
            <a href="/kategorii/@categorySlug?sub=@sub.Slug"
               class="btn btn-sm me-1 @(activeSubSlug == sub.Slug ? "btn-primary" : "btn-outline-primary")">
                @sub.Name
            </a>
        }
    </div>
}

<div class="d-flex justify-content-end align-items-center gap-2 mb-3">
    <label class="form-label mb-0 text-muted small text-nowrap">Сортиране:</label>
    <select id="sortSelect" class="form-select form-select-sm w-auto"
            onchange="applySortOrder(this.value)">
        <!option value="newest"    @(currentSort == "newest"    ? "selected" : "")>Най-нови</!option>
        <!option value="name_asc"  @(currentSort == "name_asc"  ? "selected" : "")>Азбучен ред (А→Я)</!option>
        <!option value="name_desc" @(currentSort == "name_desc" ? "selected" : "")>Азбучен ред (Я→А)</!option>
        <!option value="price_asc" @(currentSort == "price_asc" ? "selected" : "")>Най-ниска цена</!option>
        <!option value="price_desc"@(currentSort == "price_desc"? "selected" : "")>Най-висока цена</!option>
    </select>
</div>
@section Scripts {
    <script>
        function applySortOrder(sort) {
            var url = new URL(window.location.href);
            url.searchParams.set('sort', sort);
            window.location.href = url.toString();
        }
    </script>
}

<style>
    .promo-note-clamp {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
        word-break: break-word;
    }
</style>

@if (!Model.Any())
{
    <p class="text-muted">Няма намерени продукти.</p>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var product in Model)
        {
            var activePromo   = product.GetActivePromotion(DateTime.Now);
            var discount      = product.GetActiveDiscount(DateTime.Now);
            var discountLabel = product.GetDiscountLabel(DateTime.Now);
            var finalPrice    = product.GetDiscountedPrice(DateTime.Now);
            var promoNote     = activePromo?.Note;
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="position-relative">
                        @if (!string.IsNullOrEmpty(product.ImageUrl))
                        {
                            <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name"
                                 style="height: 200px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center"
                                 style="height: 200px;">
                                <span class="text-muted">Без снимка</span>
                            </div>
                        }
                        @if (discount.HasValue)
                        {
                            <span class="position-absolute top-0 start-0 m-2 d-flex align-items-center justify-content-center
                                         bg-danger text-white fw-bold rounded-circle shadow"
                                  style="width:46px;height:46px;font-size:.8rem;">
                                @discountLabel
                            </span>
                        }
                    </div>
                    <div class="card-body">
                        <h5 class="card-title">@product.Name</h5>
                        @if (product.Category != null)
                        {
                            <p class="card-text text-muted small">@product.Category.Name</p>
                        }
                        @if (!string.IsNullOrEmpty(product.Description))
                        {
                            <p class="card-text small">
                                @(product.Description.Length > 80
                                    ? product.Description[..80] + "…"
                                    : product.Description)
                            </p>
                        }
                        @if (!string.IsNullOrWhiteSpace(promoNote))
                        {
                            <p class="card-text small fw-bold text-danger mb-0 promo-note-clamp"
                               title="@promoNote">
                                @promoNote
                            </p>
                        }
                    </div>
                    <div class="card-footer d-flex justify-content-between align-items-center">
                        <div>
                            @if (discount.HasValue)
                            {
                                <span class="fw-bold text-danger me-1">@finalPrice.ToString("N0") €</span>
                                <span class="text-muted text-decoration-line-through small">@product.Price.ToString("N0") €</span>
                            }
                            else
                            {
                                <strong>@product.Price.ToString("N0") €</strong>
                            }
                        </div>
                        <div>
                            @if (product.IsCustomizable)
                            {
                                <span class="badge bg-info me-1">По поръчка</span>
                            }
                            <a asp-action="Detail" asp-route-n="@product.N" class="btn btn-primary btn-sm">Детайли</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
