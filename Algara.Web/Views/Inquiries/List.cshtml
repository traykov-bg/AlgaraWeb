@model List<Algara.Data.Models.FurnitureInquiry>
@inject Microsoft.Extensions.Localization.IStringLocalizer<Algara.Web.Localization.InquiryResources> T
@{
    var staff = (bool?)ViewData["Staff"] == true;
    Layout = staff ? "_AdminLayout" : "_Layout";
    ViewData["Title"] = T["Title"];
    var page = (int?)ViewData["Page"] ?? 1;
}
<div class="container-fluid py-4">
    <h1 class="h3">@T["Title"]</h1>
    @if (staff) { <a asp-action="StaffNew" staff-permission="Inquiries.Create" class="btn btn-primary mb-3">@T["StaffNew"]</a> }
    else { <a asp-action="New" class="btn algara-btn-primary mb-3">@T["New"]</a> }
    @if (staff)
    {
        <form method="get" class="row g-2 mb-3">
            <div class="col-md-7"><label for="q" class="form-label">@T["Search"]</label><input id="q" name="q" value="@ViewData["Query"]" maxlength="121" class="form-control" /></div>
            <div class="col-md-3"><label for="status" class="form-label">@T["Status"]</label><select id="status" name="status" class="form-select"><option value="">@T["All"]</option>@foreach (var status in Enum.GetValues<InquiryStatus>()) { <option value="@status" selected="@(ViewData["Status"] is InquiryStatus current && current == status)">@T[status == InquiryStatus.New ? "NewStatus" : status.ToString()]</option> }</select></div>
            <div class="col-md-2 d-flex align-items-end"><button type="submit" class="btn btn-outline-primary">@T["Filter"]</button></div>
        </form>
    }
    <div class="table-responsive"><table class="table align-middle"><thead><tr><th>#</th><th>@T["Name"]</th><th>@T["Phone"]</th><th>@T["Status"]</th><th>@T["StatusDate"]</th><th></th></tr></thead><tbody>
    @foreach (var row in Model)
    {
        <tr><td>@row.N</td><td>@row.ContactName</td><td>@row.Phone</td><td>@T[row.Status == InquiryStatus.New ? "NewStatus" : row.Status.ToString()]</td><td><client-time utc="@row.UpdatedAtUtc"></client-time></td><td><a asp-action="@(staff ? "StaffDetails" : "Details")" asp-route-n="@row.N">@T["Details"]</a></td></tr>
    }
    </tbody></table></div>
    @if (Model.Count == 0) { <p>@T["Empty"]</p> }
    @if (page > 1) { <a asp-action="@(staff ? "Index" : "Mine")" asp-route-page="@(page-1)" asp-route-q="@ViewData["Query"]" asp-route-status="@ViewData["Status"]" class="btn btn-outline-secondary">@T["Previous"]</a> }
    @if (Model.Count == 50) { <a asp-action="@(staff ? "Index" : "Mine")" asp-route-page="@(page+1)" asp-route-q="@ViewData["Query"]" asp-route-status="@ViewData["Status"]" class="btn btn-outline-secondary">@T["NextPage"]</a> }
</div>

@section Scripts { <script src="~/js/client-time.js" asp-append-version="true"></script> }
